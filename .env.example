# Restauração automática do Google Drive na inicialização
RESTORE_BACKUP_ON_STARTUP=true

# ID da pasta do Drive
GOOGLE_DRIVE_FOLDER_ID=1g0LxsS7Shd3-xWLE-F6kzEHj4FpO2iAX

# Nome fixo do arquivo de backup na pasta (atualizado a cada "Salvar backup no Drive")
GOOGLE_DRIVE_BACKUP_FILENAME=nossa-historia-backup.zip

# Credenciais da Service Account (obrigatório para SALVAR no Drive)
# Cole o JSON inteiro em uma linha no Render, ou use arquivo local:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# Chave da Google Drive API (opcional — só para listagem sem Service Account)
# GOOGLE_DRIVE_API_KEY=

# Manter backups antigos na pasta (padrão: false — mantém só o mais recente)
# KEEP_OLD_DRIVE_BACKUPS=true

# Para desenvolvimento local sem baixar do Drive:
# RESTORE_BACKUP_ON_STARTUP=false
