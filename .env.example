# Restauração automática do Google Drive na inicialização
# A pasta padrão já está configurada no código.
RESTORE_BACKUP_ON_STARTUP=true

# ID da pasta do Drive (opcional — já vem com o padrão do projeto)
GOOGLE_DRIVE_FOLDER_ID=1g0LxsS7Shd3-xWLE-F6kzEHj4FpO2iAX

# ID direto de um arquivo ZIP (opcional — use se quiser apontar para um arquivo específico)
# GOOGLE_DRIVE_BACKUP_FILE_ID=

# Chave da Google Drive API (opcional — melhora a confiabilidade da listagem da pasta)
# GOOGLE_DRIVE_API_KEY=

# Para desenvolvimento local sem baixar do Drive:
# RESTORE_BACKUP_ON_STARTUP=false
